# Normalise line endings so a Windows checkout does not produce a diff.
* text=auto eol=lf

# Scripts that must keep LF regardless of platform.
*.sh   text eol=lf
*.bash text eol=lf

# Windows-native scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diff, never normalise.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.woff  binary
*.woff2 binary

# Collapse lockfiles in diffs and exclude them from language stats.
*.lock            linguist-generated=true -diff
uv.lock           linguist-generated=true -diff
pnpm-lock.yaml    linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
composer.lock     linguist-generated=true -diff
go.sum            linguist-generated=true -diff
