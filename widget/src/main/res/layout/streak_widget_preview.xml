<?xml version="1.0" encoding="utf-8"?>
<!--
    What the widget picker shows for the streak widget on API 31 and up.

    A still approximation, not the widget. A Glance tree compiles to RemoteViews
    only once a composition session has run, so there is nothing to preview until
    the widget is placed - which is why previewLayout has to be hand-built. Two
    consequences worth knowing before comparing it against the real thing:

      The type is the system face, not Outfit. The widget rasterises Outfit to
      bitmaps because RemoteViews drops a bundled font (BitmapText); a preview
      layout is inflated by the picker and has no such escape. The picker is the
      one surface in this app that is deliberately off-brand in its type.

      The numbers are sample values. They are the canvas's own row set, so the
      preview shows the compact layout the three-by-two default placement gets.

    Colours come from res/values/colors.xml, which is pinned to :core:ui by
    StreakPreviewColorsTest.
-->
<!--
    tools:ignore="Overdraw": the check assumes a themed Activity is painting a
    background behind this layout, and nothing is. A widget picker inflates it
    inside the launcher's process, where no Gawi theme exists, so painting the
    ground here is the only way the preview has one - the same reason the Glance
    tree sets a background of its own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_preview_surface"
    android:orientation="vertical"
    android:padding="8dp"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_row_one"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_streak_one"
            android:textColor="@color/widget_preview_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_row_two"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_streak_two"
            android:textColor="@color/widget_preview_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_preview_as_of"
        android:textColor="@color/widget_preview_caption"
        android:textSize="12sp" />

</LinearLayout>
