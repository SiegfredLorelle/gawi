<?xml version="1.0" encoding="utf-8"?>
<!--
  The first resources in :core:ui. Resource merging is flat across the whole
  app, so every name here carries a ui_ prefix rather than risking a collision
  with a feature module's — the same rule each feature's own file states.

  What belongs here is copy that more than one feature draws (AGENTS.md's
  :core:ui rule). Copy specific to one screen stays with that screen.
-->
<resources>

    <!-- Short weekday labels, from resources rather than
         DayOfWeek.getDisplayName: that reads the JVM's locale rather than the
         app's resource configuration, so a device set to one language could
         draw a week in another. See WeekdayLabels.kt.

         One letter each, which makes Tuesday/Thursday and Saturday/Sunday
         collide on purpose — a seven-column grid has no room for more, and the
         position in the row is what disambiguates them. Anything that needs to
         *say* a weekday spells it out instead: see ui_weekday_* below, which
         the week-start picker and the history grid's spoken labels both draw.
         (This used to point at :feature:settings keeping its own full names,
         which the change that added this file made false in the same commit.) -->
    <string name="ui_day_mon">M</string>
    <string name="ui_day_tue">T</string>
    <string name="ui_day_wed">W</string>
    <string name="ui_day_thu">T</string>
    <string name="ui_day_fri">F</string>
    <string name="ui_day_sat">S</string>
    <string name="ui_day_sun">S</string>

    <!-- The same seven days spelled out, for anything that has to *say* a
         weekday rather than fit one in a column: the week-start picker's
         options, and the history grid's spoken cell labels, where the letters
         above would be read aloud as "T" and mean either of two days.

         Not DayOfWeek.getDisplayName, for the reason the letters give and one
         more: getDisplayName varies with the JVM's locale *data*, so what the
         picker reads would depend on which machine rendered it. -->
    <string name="ui_weekday_monday">Monday</string>
    <string name="ui_weekday_tuesday">Tuesday</string>
    <string name="ui_weekday_wednesday">Wednesday</string>
    <string name="ui_weekday_thursday">Thursday</string>
    <string name="ui_weekday_friday">Friday</string>
    <string name="ui_weekday_saturday">Saturday</string>
    <string name="ui_weekday_sunday">Sunday</string>

    <!-- A streak, spoken (SpokenStreak.kt). The drawn forms stay per surface —
         "3" on a Today row, "3w" under a caption on habit detail — and a screen
         reader cannot tell one from the other: TalkBack 17 read a Today badge
         as a bare "1", "7" and "1 w" (docs/running.md §4, 2026-09-02). Two
         screens say the same fact, so the words live here; the widget keeps
         its own ("7 days", spokenLabel) because its rows carry nothing else.
         "in a row" is the Today panel's own milestone phrase. Real plurals: 1
         is every first completion. -->
    <plurals name="ui_streak_days_spoken">
        <item quantity="one">%1$d day in a row</item>
        <item quantity="other">%1$d days in a row</item>
    </plurals>
    <plurals name="ui_streak_weeks_spoken">
        <item quantity="one">%1$d week in a row</item>
        <item quantity="other">%1$d weeks in a row</item>
    </plurals>
    <!-- A break says so and keeps its unit: "was 12w" would read as "was 12 w". -->
    <plurals name="ui_streak_broken_days_spoken">
        <item quantity="one">Streak broken, was %1$d day</item>
        <item quantity="other">Streak broken, was %1$d days</item>
    </plurals>
    <plurals name="ui_streak_broken_weeks_spoken">
        <item quantity="one">Streak broken, was %1$d week</item>
        <item quantity="other">Streak broken, was %1$d weeks</item>
    </plurals>

</resources>
