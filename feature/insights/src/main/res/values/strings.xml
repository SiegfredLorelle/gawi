<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource merging is flat across the whole app, so every name here carries an
  insights_ prefix rather than risking a collision with :app's or another
  feature's. The seven weekday letters the grid's columns need are not here:
  :feature:habits draws the same seven, so they live in :core:ui as ui_day_*.
-->
<resources>

    <!-- The app-wide screen. "Insights" rather than "Analytics" or "Stats":
         PRD §5 and every doc call this module insights, and a title that
         disagreed with the vocabulary would be the drift AGENTS.md warns about. -->
    <string name="insights_title">Insights</string>

    <!-- The period picker, settled 2026-08-24 (docs/ux/insights.md §7). Calendar
         periods, which is why the labels are bare nouns rather than "Last 30
         days" — Phase 1.5's quarterly and yearly retrospectives share this
         picker and a trailing window cannot serve them. -->
    <string name="insights_period_month">Month</string>
    <string name="insights_period_quarter">Quarter</string>
    <string name="insights_period_year">Year</string>

    <!-- Which breakdown of the period. One list with a toggle rather than two
         lists, so the screen reads as one view of a period. -->
    <string name="insights_breakdown_habits">Habits</string>
    <string name="insights_breakdown_tags">Tags</string>

    <!-- The stepper's caption and its two arrows — Phase 1.5's retrospective
         (docs/ux/insights.md §9). A month is titled with insights_month_title,
         the grid's own, so one template serves both steppers. The quarter is
         "Q3 2026" rather than a month range because the chips already say the
         period is a quarter, and a range would be the longest label on the row
         at 200% font. -->
    <string name="insights_period_quarter_title">Q%1$d %2$d</string>
    <string name="insights_period_year_title">%d</string>
    <string name="insights_period_earlier">Earlier period</string>
    <string name="insights_period_later">Later period</string>

    <!-- The focus sentence. The largest tagged total this period against the
         one before; nothing is said when either had no tagged completion. Tags
         are the user's own words, so they are dropped in as typed. -->
    <string name="insights_focus_shifted">Focus shifted from %1$s to %2$s.</string>
    <string name="insights_focus_held">Still mostly %1$s.</string>

    <!-- The trend card: active days per month across a quarter or a year. The
         subtitle names the denominator, as the rate card names its schedule,
         because a count out of the days a month has had is not a completion
         rate and must not be read as one. insights_trend_point is one
         column's spoken form — "March, 15 active days" — since under twelve
         columns the visible label is a bare initial. -->
    <string name="insights_trend_title">Active days per month</string>
    <string name="insights_trend_subtitle">Days with at least one completion</string>
    <string name="insights_trend_point">%1$s, %2$s</string>

    <!-- One initial per month for the year's twelve trend columns, where a name
         cannot fit. A resource rather than the first character of the name, for
         the reason the weekday letters are: an initial is the translator's call,
         and J, M and A each naming two months is covered by every column's
         spoken form (insights_trend_point), not by the letter. -->
    <string name="insights_month_initial_january">J</string>
    <string name="insights_month_initial_february">F</string>
    <string name="insights_month_initial_march">M</string>
    <string name="insights_month_initial_april">A</string>
    <string name="insights_month_initial_may">M</string>
    <string name="insights_month_initial_june">J</string>
    <string name="insights_month_initial_july">J</string>
    <string name="insights_month_initial_august">A</string>
    <string name="insights_month_initial_september">S</string>
    <string name="insights_month_initial_october">O</string>
    <string name="insights_month_initial_november">N</string>
    <string name="insights_month_initial_december">D</string>

    <!-- The best run inside the period, in the schedule's own unit, beside the
         schedule label on an adherence row. No "worst": every habit's worst
         run is zero, and a zero under every row would say nothing. -->
    <plurals name="insights_best_days">
        <item quantity="one">best %d day</item>
        <item quantity="other">best %d days</item>
    </plurals>
    <plurals name="insights_best_weeks">
        <item quantity="one">best %d week</item>
        <item quantity="other">best %d weeks</item>
    </plurals>

    <!-- The headline. Two exact numbers that need no denominator: "every habit
         done" is not answerable for a past day, because a weekly habit has no
         due day at all (§4), so this says the user turned up rather than
         claiming to know what turning up fully would have meant. -->
    <plurals name="insights_active_days">
        <item quantity="one">%d active day</item>
        <item quantity="other">%d active days</item>
    </plurals>
    <plurals name="insights_completions">
        <item quantity="one">%d completion</item>
        <item quantity="other">%d completions</item>
    </plurals>

    <!-- Untagged effort is a row, never an omission: drop it and the rows
         describe a whole that is not the whole (§5). Capitalised because it
         stands where a tag name would, and tags are the user's own words. -->
    <string name="insights_untagged">Untagged</string>

    <!-- Two empty states, not one. This pair is for a period with no
         completions in it, which is what the Tags breakdown runs out of. -->
    <string name="insights_empty_title">Nothing logged yet</string>
    <string name="insights_empty_body">No completions in this period. Try a longer one, or tick something off on Today.</string>

    <!-- No habit at all, which is a fresh install and the commonest way to
         reach this screen empty — the app bar offers Insights before a first
         habit exists. Points at where a habit is made, because that is the one
         thing to do about it. -->
    <string name="insights_no_habits_yet_title">No habits yet</string>
    <string name="insights_no_habits_yet_body">Add one on Today and its adherence shows up here.</string>

    <!-- And this pair is for habits that all exist and are all archived, which
         is a different thing again: the period may be full of completions from
         them. Saying "nothing logged" there would contradict the headline two
         rows above it, and saying "no habits yet" would be untrue. -->
    <string name="insights_no_habits_title">No habits to report on</string>
    <string name="insights_no_habits_body">Every habit is archived, so there is no adherence to measure. Tags still shows where the effort went.</string>

    <string name="insights_history_title">History</string>
    <string name="insights_back">Back</string>

    <!-- The month name comes from resources rather than
         java.time.format.DateTimeFormatter, for the reason :core:ui's
         WeekdayLabels gives: a formatter reads the JVM's locale rather than the
         app's resource configuration. -->
    <string name="insights_month_title">%1$s %2$d</string>
    <string name="insights_month_january">January</string>
    <string name="insights_month_february">February</string>
    <string name="insights_month_march">March</string>
    <string name="insights_month_april">April</string>
    <string name="insights_month_may">May</string>
    <string name="insights_month_june">June</string>
    <string name="insights_month_july">July</string>
    <string name="insights_month_august">August</string>
    <string name="insights_month_september">September</string>
    <string name="insights_month_october">October</string>
    <string name="insights_month_november">November</string>
    <string name="insights_month_december">December</string>

    <string name="insights_month_previous">Earlier month</string>
    <string name="insights_month_next">Later month</string>

    <!-- Spoken labels for one day: the weekday spelled out, then the date.

         The weekday is here rather than left to the column headers because a
         one-letter header cannot be read aloud — T and S each name two days —
         so the headers are hidden from a screen reader and each cell carries
         the weekday itself. That is a better answer than the columns could
         give: "I keep missing Sundays" is a thing this grid should be able to
         tell someone who cannot see it.

         The month is not repeated per cell; it is in the header above the grid,
         and thirty-one cells that each named it would be thirty-one stops of
         mostly the same words.

         "Not done" rather than "missed". docs/ux/insights.md §4: a weekly habit
         has no scheduled days, so a day it was not done is not a day it was
         missed, and the grid says the same thing to a screen reader as it does
         in colour. -->
    <string name="insights_day_done">%1$s %2$d, done</string>
    <string name="insights_day_not_done">%1$s %2$d, not done</string>
    <string name="insights_day_today_done">%1$s %2$d, today, done</string>
    <string name="insights_day_today_not_done">%1$s %2$d, today, not done yet</string>

    <!-- The completion-rate trend. "Finished periods only" is not said here
         because it is not true of the current month: Rates counts only finished
         units on both sides of the fraction, so a part-month is 15 of 15 rather
         than 15 of 31 and is already comparable. A dash means the month held
         nothing that had finished at all. -->
    <string name="insights_rate_title">Completion rate</string>
    <string name="insights_rate_none">\u2014</string>
    <string name="insights_rate_percent">%1$d%%</string>

    <!-- What the percentages are a rate of. docs/ux/insights.md §4: a daily
         habit's rate and a weekly habit's are different fractions, and only
         this line says which these are. Same wording as :feature:habits'
         schedule subtitle, in this module's own resources because ids do not
         cross a module boundary. -->
    <string name="insights_schedule_daily">Every day</string>
    <string name="insights_schedule_weekly">%1$d\u00d7 a week</string>

    <!-- The history screen's failure. Names a history because that is what the
         user opened; the app-wide screen has its own pair below, since a failed
         read there is about no particular habit. -->
    <string name="insights_unavailable_title">Can\'t show this history</string>
    <string name="insights_unavailable_body">Something went wrong reading it. Close the app and open it again to retry.</string>

    <!-- And the app-wide screen's. It reused the pair above until review caught
         it, which told someone who had opened Insights that a *history* could
         not be shown. -->
    <string name="insights_read_failed_title">Can\'t show your insights</string>
    <string name="insights_read_failed_body">Something went wrong reading them. Close the app and open it again to retry.</string>

</resources>
