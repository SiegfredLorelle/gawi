<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource merging is flat across the whole app, so every name here carries a
  settings_ prefix rather than risking a collision with :app's, :feature:today's
  or :feature:habits'.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="settings_title">Settings</string>
    <string name="settings_back">Back</string>

    <string name="settings_unavailable_title">Can\'t open your settings</string>
    <string name="settings_unavailable_body">Something went wrong reading them. Close the app and open it again to retry.</string>

    <!-- The three settings. Each help line says what the setting changes and,
         where it is not obvious, what it does not change — the day cutoff in
         particular does not re-file anything already logged (architecture §5). -->
    <string name="settings_day_cutoff_label">Day starts at</string>
    <string name="settings_day_cutoff_help">Habits logged before this time count as the previous day. Changing it affects new entries only — what you have already logged stays on the day it was logged.</string>

    <string name="settings_week_start_label">Week starts on</string>
    <string name="settings_week_start_help">Which day weekly habits count from. Changing it re-counts the current week straight away.</string>

    <string name="settings_reminder_label">Day is nearly over at</string>
    <string name="settings_reminder_help">When Momo starts looking worried about anything still outstanding, and when the end-of-day reminder arrives if anything is.</string>
    <!-- Says what is not happening rather than naming a permission: below API 33
         there is nothing to grant and the user simply switched notifications off,
         so "allow the permission" would be wrong on some versions and jargon on
         all of them. docs/ux/reminder.md §3. -->
    <string name="settings_reminder_blocked">Notifications are off, so this reminder will not arrive.</string>
    <string name="settings_reminder_enable">Turn notifications on</string>
    <!-- The one refusable settings write. reminderOn resolves a reminder equal to
         the cutoff to the day's START, so the pair is meaningless rather than
         merely odd — docs/ux/reminder.md 6. -->
    <string name="settings_error_reminder_equals_cutoff">The reminder can\'t be at the day boundary itself — pick another time.</string>

    <!-- The week-start picker's seven day names are :core:ui's ui_weekday_* —
         the history grid speaks the same seven, and copy two features draw
         lives there. SettingsUiMapper.labelFor still names which form this
         screen wants. -->

    <string name="settings_confirm">Set</string>
    <string name="settings_cancel">Cancel</string>

    <!-- The Data section. Neither row is a setting, and only one of them has
         anything set: the export row's value line is how long ago the log was
         last written to a file, which is the 30-day nudge PRD §5 asks for. The
         import row has no value and never will — nothing an import leaves
         behind is a thing to report. -->
    <string name="settings_data_header">Data</string>

    <string name="settings_export_label">Export a copy</string>
    <string name="settings_export_help">Writes every habit and everything you have logged to a JSON file, wherever you choose to put it. Nothing is sent anywhere — moving that file off this phone is up to you, and it is the only backup there is.</string>

    <!-- The value line. Nothing here is shown on a log with no events in it: a
         fresh install has nothing to lose, and warning it about that is noise.
         A quantity resource rather than one %d string, because this sentence
         has exactly one number in it — unlike the import result below, which
         has two and therefore cannot be one. -->
    <string name="settings_export_never">Never exported</string>
    <string name="settings_export_today">Last exported today</string>
    <plurals name="settings_export_days_ago">
        <item quantity="one">Last exported %d day ago</item>
        <item quantity="other">Last exported %d days ago</item>
    </plurals>

    <!-- The nudge itself, in place of the help line once a backup is overdue.
         Gentle, per PRD §5, and in-app only — this app has no notification
         permission and asks for none. It carries no number, because the value
         line directly above it already does. -->
    <string name="settings_export_overdue_help">There is no other copy of your history on this phone or anywhere else. Export one and keep it somewhere you would still have it if you lost this phone.</string>

    <!-- The CSV row. Third in the section and the one that is NOT a recovery
         path, which the help line has to carry in words because nothing about
         its position says so: it holds no events and no habit settings, so
         nothing can be rebuilt from it. docs/ux/settings.md §6 has the argument.
         It gets no value line and no nudge for the same reason. -->
    <string name="settings_export_csv_label">Export completions</string>
    <string name="settings_export_csv_help">Writes every day you have logged to a CSV file for a spreadsheet. This is not a backup: it holds no habits and no settings, and it cannot be imported back. Use \"Export a copy\" above for that.</string>

    <string name="settings_import_label">Import a file</string>
    <string name="settings_import_help">Adds what a Gawi export holds to what is already here. Nothing is replaced and nothing is removed, so importing the same file twice changes nothing the second time.</string>

    <!-- Shown in place of the help line while the work runs, and announced as
         a live region: a row that has gone dead and says nothing reads as
         broken. -->
    <string name="settings_export_running">Writing the file…</string>
    <string name="settings_import_running">Reading the file…</string>
    <string name="settings_export_csv_running">Writing the spreadsheet…</string>

    <!-- Export speaks on success where a settings write does not. There is no
         row redrawing to be the feedback, and the file went somewhere this app
         is never told about. -->
    <string name="settings_export_done">Exported. That file is the only copy — keep it somewhere other than this phone.</string>

    <!-- The CSV speaks on success too, and says what the file is rather than
         congratulating the user on a backup they did not make.

         No count and therefore no quantity resource, which is a copy decision
         rather than a limitation. A number here would have to govern a noun —
         "1 completions" — so it would need a <plurals>, and a plurals id cannot
         travel through SettingsMessage, which resolves through getString. The
         rule this file already follows is to write copy that needs neither, and
         the count's one job that copy cannot do is telling an empty export from
         a full one, which the second string does. -->
    <string name="settings_export_csv_done">Exported. That file is a spreadsheet, not a backup, and it cannot be imported back.</string>
    <string name="settings_export_csv_empty">Nothing has been logged yet, so that file holds only its column headings.</string>

    <!-- Two independent counts in one sentence, which a <plurals> cannot
         express: a quantity resource selects on one number. Composing two
         translated fragments to dodge that is worse than one sentence, so the
         copy is written to need neither — "1 added, 1 already here" and "128
         added, 12 already here" are both grammatical. The cases where a count
         is zero get their own string from messageFor() rather than reading
         "0 added". -->
    <string name="settings_import_done" tools:ignore="PluralsCandidate">Imported that file: %1$d added, %2$d already here.</string>
    <string name="settings_import_nothing_new">Nothing new in that file. Everything in it was already here.</string>
    <string name="settings_import_empty">That file had nothing in it. Nothing changed.</string>

    <!-- The only failure this screen can report. A settings write validates
         nothing and refuses nothing, so the only way it fails is by throwing. -->
    <string name="settings_error_unexpected">That did not save. Try again.</string>

    <!-- Export refuses to claim nothing was written: the picker has already
         created the document by the time a write can fail, so a truncated file
         with a plausible name is exactly what someone would later trust. -->
    <string name="settings_error_export">That export did not finish. Delete the file it started rather than trusting it, and try again.</string>

    <!-- Narrower than the message above it, deliberately. A half-written
         spreadsheet is a nuisance; a half-written backup is a file someone
         would later trust with their whole history. -->
    <string name="settings_error_export_csv">That did not finish. The file it started is incomplete, so delete it and try again. Nothing else changed.</string>

    <!-- Import validates the whole file before it writes anything, so these
         two can both promise that nothing changed. -->
    <string name="settings_error_import_unreadable">That is not a Gawi export, or it is damaged. Nothing was changed.</string>
    <string name="settings_error_import_newer">That export came from a newer version of Gawi. Update the app and try again — the file is fine.</string>
    <string name="settings_error_import">That import did not finish. Nothing was changed.</string>
</resources>
