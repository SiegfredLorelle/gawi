<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource merging is flat across the whole app, so every name here carries a
  today_ prefix rather than risking a collision with :app's own.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="today_error_retro_window">That day is more than three days ago. Only the last three days can be edited.</string>
    <string name="today_error_future_date">That day has not happened yet.</string>
    <string name="today_error_habit_missing">That habit no longer exists.</string>
    <string name="today_error_habit_archived">That habit is archived.</string>
    <string name="today_error_unexpected">That did not work. Try again.</string>

    <string name="today_title">Today</string>
    <string name="today_unavailable_title">Can\'t open your habits</string>
    <string name="today_unavailable_body">Something went wrong reading them. Close the app and open it again to retry.</string>
    <string name="today_empty_title">No habits yet</string>
    <string name="today_empty_body">Momo is waiting. Add a habit and it starts here.</string>

    <!-- "2/3 this week", for weekly habits only. Daily rows have no subtitle.
         Not a plural: the numbers are a ratio and "week" is not what they
         count, so there is no singular form to write. The wording is fixed by
         docs/ux/today-view.md §5. -->
    <string name="today_week_progress" tools:ignore="PluralsCandidate">%1$d/%2$d this week</string>

    <!-- A daily streak counts days and a weekly one counts weeks, and the two
         must never read as the same number, so the week form carries a unit. -->
    <string name="today_streak_days">%d</string>
    <string name="today_streak_weeks">%dw</string>
    <string name="today_streak_broken">0</string>
    <string name="today_streak_was_days">was %d</string>
    <string name="today_streak_was_weeks">was %dw</string>
    <!-- Stands in for the cut-thread glyph the sketch draws. A resource so
         swapping it for a vector is a one-file change. -->
    <string name="today_streak_broken_glyph">\u2702</string>

    <!-- One line per mood (today-view §4), read as the panel's description
         beside the drawn face. Placeholder wording still — §4's per-mood copy
         is not designed — with one exception: the regenerating line names the
         habit, which is the half of it §4 did specify ("names the habit and
         offers the repair"). The unnamed form is what shows when the mood is
         regenerating but no habit can be named — a weekly habit ticked today
         but short of its target keeps a broken streak, and the line will not
         ask for a repair the user has already made. -->
    <string name="today_mood_happy">All done. Momo is thriving.</string>
    <string name="today_mood_neutral">Momo is pottering about.</string>
    <string name="today_mood_worried">Momo is getting worried.</string>
    <string name="today_mood_regenerating">Momo is regrowing a gill. Pick the thread back up.</string>
    <string name="today_mood_regenerating_named">Momo is regrowing a gill. Pick %1$s back up.</string>
    <string name="today_mood_empty">Momo is waiting for a habit.</string>
    <!-- An x-of-y ratio rather than a count of a noun, so there is no singular
         form to write. All of this panel's copy is placeholder either way —
         §4's per-mood wording is not designed — and plurals get revisited when
         it is. -->
    <string name="today_remaining" tools:ignore="PluralsCandidate">%1$d of %2$d left today</string>
    <string name="today_remaining_none">Nothing left today</string>

    <!-- The app-bar chip's count (today-view §1), deliberately shorter than the
         panel's line above: the chip replaces the title beside three action
         icons, and the full sentence does not fit there at a large font scale.
         What TalkBack speaks is the panel's line, not these — see TodayChip. -->
    <string name="today_chip_remaining" tools:ignore="PluralsCandidate">%1$d left</string>
    <string name="today_chip_remaining_none">All done</string>
    <!-- The line the panel shows for the length of a streak-milestone
         celebration (momo.md §6), in place of the mood line; it is the
         announcement. A count of a noun, so real plurals like the widget's —
         1 never occurs on either ladder, but other locales split 4, 7 and 30. -->
    <plurals name="today_milestone_days">
        <item quantity="one">%1$d day in a row. Momo is dazzled.</item>
        <item quantity="other">%1$d days in a row. Momo is dazzled.</item>
    </plurals>
    <plurals name="today_milestone_weeks">
        <item quantity="one">%1$d week in a row. Momo is dazzled.</item>
        <item quantity="other">%1$d weeks in a row. Momo is dazzled.</item>
    </plurals>
    <!-- The same milestone, short enough for the app-bar chip, and short for the
         same reason today_chip_remaining is: the bar holds one string beside
         three action icons. Reusing the panel's sentence above truncated it to
         "7 days in a row. Mom…" on a 720 dp screen at font scale 1.0 — caught on
         a device 2026-09-01, not by any test, because a Compose test asserting
         the string is present passes on a node that draws it clipped.
         What TalkBack speaks is still the panel's full sentence — see TodayChip. -->
    <plurals name="today_chip_milestone_days">
        <item quantity="one">%1$d day!</item>
        <item quantity="other">%1$d days!</item>
    </plurals>
    <plurals name="today_chip_milestone_weeks">
        <item quantity="one">%1$d week!</item>
        <item quantity="other">%1$d weeks!</item>
    </plurals>

    <!-- The empty state's call to action, and the way to the habit list. The
         body copy has promised the first of these since the screen was built. -->
    <string name="today_add_habit">Add a habit</string>
    <string name="today_manage_habits">Manage habits</string>
    <string name="today_insights">Insights</string>
    <string name="today_settings">Settings</string>

    <string name="today_complete">Mark done</string>
    <string name="today_undo">Mark not done</string>
</resources>
