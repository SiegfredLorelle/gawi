<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource merging is flat across the whole app, so every name here carries a
  today_ prefix rather than risking a collision with :app's own.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="today_error_retro_window">That day is more than three days ago. Only the last three days can be edited.</string>
    <string name="today_error_future_date">That day has not happened yet.</string>
    <string name="today_error_habit_missing">That habit no longer exists.</string>
    <string name="today_error_habit_archived">That habit is archived.</string>
    <string name="today_error_unexpected">That did not work. Try again.</string>

    <string name="today_title">Today</string>
    <string name="today_empty_title">No habits yet</string>
    <string name="today_empty_body">Momo is waiting. Add a habit and it starts here.</string>

    <!-- "2/3 this week", for weekly habits only. Daily rows have no subtitle.
         Not a plural: the numbers are a ratio and "week" is not what they
         count, so there is no singular form to write. The wording is fixed by
         docs/ux/today-view.md §5. -->
    <string name="today_week_progress" tools:ignore="PluralsCandidate">%1$d/%2$d this week</string>

    <!-- A daily streak counts days and a weekly one counts weeks, and the two
         must never read as the same number, so the week form carries a unit. -->
    <string name="today_streak_days">%d</string>
    <string name="today_streak_weeks">%dw</string>
    <string name="today_streak_broken">0</string>
    <string name="today_streak_was_days">was %d</string>
    <string name="today_streak_was_weeks">was %dw</string>
    <!-- Stands in for the cut-thread glyph the sketch draws. A resource so
         swapping it for a vector is a one-file change. -->
    <string name="today_streak_broken_glyph">\u2702</string>

    <!-- Phase 0's three states (PRD §5). §4's four moods collapse onto them
         through Mood.toMvp, so Phase 1 adds art here and not logic. -->
    <string name="today_mood_happy">All done. Momo is thriving.</string>
    <string name="today_mood_neutral">Momo is pottering about.</string>
    <string name="today_mood_worried">Momo is getting worried.</string>
    <string name="today_mood_empty">Momo is waiting for a habit.</string>
    <!-- An x-of-y ratio rather than a count of a noun, so there is no singular
         form to write. All of this panel's copy is placeholder either way —
         §4's per-mood wording is not designed — and plurals get revisited when
         it is. -->
    <string name="today_remaining" tools:ignore="PluralsCandidate">%1$d of %2$d left today</string>
    <string name="today_remaining_none">Nothing left today</string>

    <string name="today_complete">Mark done</string>
    <string name="today_undo">Mark not done</string>
</resources>
