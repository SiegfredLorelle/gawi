<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource merging is flat across the whole app, so every name here carries a
  habits_ prefix rather than risking a collision with :app's or :feature:today's.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- The list -->
    <string name="habits_title">Habits</string>
    <string name="habits_back">Back</string>
    <string name="habits_add">Add habit</string>
    <string name="habits_empty_title">No habits yet</string>
    <string name="habits_empty_body">Add one and it starts showing up on Today.</string>
    <string name="habits_unavailable_title">Can\'t open your habits</string>
    <string name="habits_unavailable_body">Something went wrong reading them. Close the app and open it again to retry.</string>
    <string name="habits_archived_header">Archived</string>
    <string name="habits_archive">Archive</string>
    <string name="habits_unarchive">Bring back</string>
    <string name="habits_edit">Edit</string>
    <!-- The row's click label. "Open" rather than "Edit" since 2026-08-21: the
         title block leads to detail, and detail is where Edit now lives. -->
    <string name="habits_open">Open</string>

    <!-- A schedule, as the list summarises it. Not a plural: the weekly form is
         a target rather than a count of a noun, and "1 times a week" is a case
         the stepper can reach, so the copy has to read for it. -->
    <string name="habits_schedule_daily">Every day</string>
    <string name="habits_schedule_weekly" tools:ignore="PluralsCandidate">%d× a week</string>

    <!-- The editor -->
    <string name="habits_new_title">New habit</string>
    <string name="habits_edit_title">Edit habit</string>
    <string name="habits_cancel">Cancel</string>
    <string name="habits_save">Save</string>
    <string name="habits_name_label">Name</string>
    <string name="habits_name_error">Give it a name.</string>
    <string name="habits_icon_label">Icon</string>
    <string name="habits_color_label">Colour</string>
    <!-- Read out by assistive technology in place of the hex, which would
         otherwise be spelled character by character. Same order as
         HabitPalette.Colors; HabitsUiMapperTest pins that they stay in step. -->
    <string name="habits_color_red">Red</string>
    <string name="habits_color_pink">Pink</string>
    <string name="habits_color_purple">Purple</string>
    <string name="habits_color_blue">Blue</string>
    <string name="habits_color_teal">Teal</string>
    <string name="habits_color_green">Green</string>
    <string name="habits_color_yellow">Yellow</string>
    <string name="habits_color_orange">Orange</string>
    <string name="habits_tag_label">Tag (optional)</string>
    <string name="habits_schedule_label">Schedule</string>
    <string name="habits_schedule_daily_option">Daily</string>
    <string name="habits_schedule_weekly_option">Weekly</string>
    <!-- Same reasoning as habits_schedule_weekly. -->
    <string name="habits_weekly_target" tools:ignore="PluralsCandidate">%d× a week</string>
    <string name="habits_target_fewer">One fewer</string>
    <string name="habits_target_more">One more</string>
    <string name="habits_editor_unavailable_title">Can\'t open that habit</string>
    <string name="habits_editor_unavailable_body">It could not be read. Go back and try again.</string>

    <!-- Habit detail (PRD §6.6's second streak surface) -->
    <string name="habits_detail_title">Habit</string>
    <string name="habits_detail_edit">Edit habit</string>
    <string name="habits_detail_tag">#%s</string>
    <string name="habits_detail_archived">Archived</string>
    <string name="habits_detail_done">Done today</string>
    <string name="habits_detail_not_done">Not done yet today</string>
    <!-- "2/3 this week", the same wording the Today row uses — docs/ux/today-view.md
         §5 fixes it, and detail disagreeing with the row that led to it would be
         its own bug. Positional, so a translation may reorder the two numbers.
         Not a plural: the numbers are a ratio and "week" is not what they count,
         so there is no singular form to write. -->
    <string name="habits_detail_week_progress" tools:ignore="PluralsCandidate">%1$d/%2$d this week</string>

    <!-- The streak, in the schedule's own unit. docs/ux/today-view.md §5: a
         daily streak is a count and a weekly one is in weeks, and "the two must
         never be styled as the same number" — hence the w, and a caption that
         names the unit rather than leaving it to the colour. -->
    <string name="habits_detail_streak_days">%d</string>
    <string name="habits_detail_streak_weeks">%dw</string>
    <string name="habits_detail_streak_days_caption">day streak</string>
    <string name="habits_detail_streak_weeks_caption">week streak</string>
    <string name="habits_detail_streak_none">No completions yet</string>
    <!-- A break keeps what it lost as context — §5's "was 4" and its cut thread. -->
    <string name="habits_detail_streak_broken">0</string>
    <string name="habits_detail_streak_broken_glyph">\u2702</string>
    <string name="habits_detail_streak_was_days">was %d</string>
    <string name="habits_detail_streak_was_weeks">was %dw</string>

    <!-- The retro strip (PRD §5's three-day window, docs/ux/today-view.md §5).
         Short weekday labels, from resources rather than DayOfWeek.getDisplayName,
         which reads the JVM locale instead of the app's configuration. -->
    <string name="habits_day_mon">M</string>
    <string name="habits_day_tue">T</string>
    <string name="habits_day_wed">W</string>
    <string name="habits_day_thu">T</string>
    <string name="habits_day_fri">F</string>
    <string name="habits_day_sat">S</string>
    <string name="habits_day_sun">S</string>

    <string name="habits_strip_title">Recent days</string>
    <!-- Spoken labels. The date is the subject, so it leads; the two initials
         M and T repeat across the week and cannot identify a cell on their own. -->
    <string name="habits_strip_done">Day %1$d, done</string>
    <string name="habits_strip_not_done">Day %1$d, not done</string>
    <string name="habits_strip_shut">Day %1$d, too old to change</string>
    <string name="habits_strip_complete">Mark done</string>
    <string name="habits_strip_undo">Mark not done</string>
    <string name="habits_strip_note">Add or edit note</string>
    <!-- Appended to a cell's spoken label when that day carries a note. The dot
         beside the tick says the same thing to anyone who can see it. -->
    <string name="habits_strip_has_note">has a note</string>

    <!-- The note sheet (PRD §5's optional note per completion, §6.3: never in
         the way of the base flow, so it is behind a long-press on a day already
         logged). Clear is its own button and not a disabled Save -
         docs/ux/today-view.md §5 - because an empty note is a real write. -->
    <string name="habits_note_title">Note for day %1$d</string>
    <string name="habits_note_label">Note (optional)</string>
    <string name="habits_note_clear">Clear note</string>

    <!-- The honesty prompt. PRD §5 fixes this wording; §6.4 wants retroactive
         edits to carry deliberate friction while staying possible. It is UI
         friction only - architecture §5 is explicit that the window is a
         command validation and this prompt has nothing enforcing it. -->
    <string name="habits_retro_title">Logging for a previous day</string>
    <string name="habits_retro_body">You\'re logging for a previous day — make sure this is accurate. Be true to yourself.</string>
    <string name="habits_retro_confirm">Log it</string>

    <!-- Rejections. All six CommandErrors are reachable from this module now
         that the retro strip writes completions; before it, the four completion
         errors could not arrive here at all. -->
    <string name="habits_error_blank_name">Give the habit a name before saving.</string>
    <string name="habits_error_habit_missing">That habit no longer exists.</string>
    <string name="habits_error_archived">Bring this habit back before changing it.</string>
    <!-- Reachable only if the day rolls over between the strip being drawn and
         a tap landing, so it names the limit rather than blaming the tap. -->
    <string name="habits_error_retro_window">You can only change the last few days.</string>
    <string name="habits_error_completion_missing">That day is no longer logged.</string>
    <string name="habits_error_unexpected">That did not work. Try again.</string>
</resources>
