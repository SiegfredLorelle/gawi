<?xml version="1.0" encoding="utf-8"?>
<!--
    The notification's small icon: the launcher mark at 24dp.

    A vector in this app's own resources, never a framework drawable
    (docs/ux/reminder.md §4). Since API 21 a small icon is drawn from its
    alpha channel only and tinted by the system, so this is a silhouette by
    construction — and since visual-identity §7.1 the mark is one gill cluster
    rather than a face, so there is nothing left to cut out of it. The paler
    body circle is the same fill here: flattened, the cluster is three lobes,
    which is what holds at this size.

    The same geometry as the launcher, scaled 24/108.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M6,14.4 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0 Z M8.25,9.6 a3.75,3.75 0 1,1 7.5,0 a3.75,3.75 0 1,1 -7.5,0 Z M12.9,12.3 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0 Z M10.65,13.8 a2.25,2.25 0 1,1 4.5,0 a2.25,2.25 0 1,1 -4.5,0 Z" />
</vector>
