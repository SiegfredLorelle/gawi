<?xml version="1.0" encoding="utf-8"?>
<!--
    The reminder's notification small icon.

    A vector rather than android.R.drawable.ic_popup_reminder, which is what this
    started as. Since API 21 a small icon is drawn from its **alpha channel only**
    and tinted by the system, so a legacy full-colour framework bitmap renders as a
    silhouette at best and a filled blob at worst — and a platform
    android.R.drawable is not a stable appearance contract across API levels and
    OEM skins either. Flagged in PR review; docs/ux/reminder.md §4 records it.

    Solid white on transparent, which is the only thing a small icon may be. The
    launcher icon is still @android:drawable/sym_def_app_icon and is deliberately
    untouched: this is a defect fix, not the design pass both are waiting for.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,22c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.89,2 2,2zM18,16v-5c0,-3.07 -1.64,-5.64 -4.5,-6.32V4c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v0.68C7.63,5.36 6,7.92 6,11v5l-2,2v1h16v-1l-2,-2z" />
</vector>
