<?xml version="1.0" encoding="utf-8"?>
<!--
    The notification's small icon: the launcher mark at 24dp.

    A vector in this app's own resources, never a framework drawable
    (docs/ux/reminder.md §4). Since API 21 a small icon is drawn from its
    alpha channel only and tinted by the system, so this is a silhouette by
    construction — and since visual-identity §7.1 the mark is one gill cluster
    rather than a face, so there is nothing left to cut out of it. The paler
    body circle is the same fill here: flattened, the cluster is three lobes,
    which is what holds at this size.

    **Not a plain 24/108 scale of the launcher, and that is the whole of what
    this file adds.** A launcher masks away all but the central 72 of the 108
    grid, so the mark is drawn with margins that are invisible there; a small
    icon has no mask, and a faithful rescale would leave it filling about half
    the canvas beside system icons that fill it. So the mark's bounding box is
    centred on the canvas and scaled to 20 of 24 — the platform's own 2 dp
    inset a side. Same geometry, different framing, and the framing is the
    reason to state it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M2,16.302 a4.651,4.651 0 1,1 9.302,0 a4.651,4.651 0 1,1 -9.302,0 Z M5.488,8.86 a5.814,5.814 0 1,1 11.628,0 a5.814,5.814 0 1,1 -11.628,0 Z M12.698,13.047 a4.651,4.651 0 1,1 9.302,0 a4.651,4.651 0 1,1 -9.302,0 Z M9.21,15.372 a3.488,3.488 0 1,1 6.976,0 a3.488,3.488 0 1,1 -6.976,0 Z" />
</vector>
