<?xml version="1.0" encoding="utf-8"?>
<!-- API 29-30 counterpart of data_extraction_rules.xml (which Android only
     reads from API 31). Same intent: even if allowBackup is ever flipped,
     nothing is backed up (architecture §6). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
