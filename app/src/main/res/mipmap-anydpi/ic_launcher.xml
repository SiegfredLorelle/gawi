<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive launcher icon (docs/ux/visual-identity.md §7.1). Vector all
    the way down: minSdk is 29, so there are no raster densities and no -v26
    qualifier (which lint's ObsoleteSdkInt would fail under warningsAsErrors).

    <monochrome> is API 33, and it is declared here rather than in a -v33
    variant on purpose: lint does not count it as an unused attribute, and its
    MonochromeLauncherIcon check *fails* an adaptive icon without one, because
    Android 16 QPR 2 and later tint the colour layer when none is offered.
    Older levels ignore the element. Measured, 2026-08-25, against the split.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
